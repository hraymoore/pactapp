# Copy this file to .env and fill in the keys you have. Every integration
# below is written to work for real the moment its key is present — with
# none set, Pact still runs fully (auth, contracts, native e-signature,
# time-stamped audit trail, PDF export) and each unconfigured integration
# fails closed with a clear message instead of faking a response.

PORT=4000

# Required in production — sign & verify login sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Pact AI (drafting, clause suggestions, contract analysis) ---
# Professional & Enterprise tiers. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Billing (Stripe Checkout + subscriptions) ---
# Without this, tier changes apply directly (no payment collected) — fine
# for a preview, not for production. Get keys at https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Identity / ID verification (Stripe Identity) ---
# Verifies a government ID + selfie without Pact ever storing the document
# or SSN itself — Stripe Identity holds that data and returns a pass/fail
# verification result. Uses the same Stripe account/key as billing above.
# https://dashboard.stripe.com/identity
STRIPE_IDENTITY_ENABLED=true

# --- Email (contract-signing invitations, notifications) ---
# Without this, signing links are shown in the UI to copy/share manually.
# Pact uses SendGrid's SMTP relay. SMTP_USER is always the literal string
# "apikey" (not your SendGrid account email) — SMTP_PASS is the API key
# itself. Create one at https://app.sendgrid.com/settings/api_keys with at
# least "Mail Send" permission, and verify SMTP_FROM as a sender identity
# (single sender or authenticated domain) at
# https://app.sendgrid.com/settings/sender_auth before sending — SendGrid
# rejects mail From an unverified address.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=Pact <no-reply@pactappstore.com>

# --- Attorney review requests ---
# Set this to YOUR OWN Pact login email to unlock /attorney-queue.html and
# receive an email every time someone pays for a review — Pact has no
# staff/admin role system yet, so this env var is the entire access gate.
# Leave unset and the request/payment flow still works, you just won't see
# a queue or get notified (see server/README.md).
ATTORNEY_REVIEW_ADMIN_EMAIL=

# Used to build links in scheduled-job/notification emails (expiration
# reminders, attorney review notifications) when they aren't sent from
# within a live request. Defaults to https://www.pactappstore.com.
PUBLIC_URL=

# --- Scheduled jobs (expiration reminders, annual-pass reminders) ---
# A Render Cron Job (or any external scheduler) runs as its own separate
# process with no access to this service's database — it can't run
# scripts/send-*-reminders.js directly. Instead it pings this service's
# POST /api/internal/run-expiration-reminders and
# /api/internal/run-annual-pass-reminders (see routes/internal.js), which
# do the real work in-process, with real DB access. INTERNAL_JOB_SECRET
# must be set to the same value here AND on each cron job's own
# environment (as INTERNAL_JOB_SECRET there too) — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset and both /api/internal/* routes refuse every request (501).
INTERNAL_JOB_SECRET=

# Only needed on the cron jobs themselves (scripts/ping-*-reminders.js),
# not on the web service — the base URL they call back to. Defaults to
# https://pactapp.onrender.com.
PACT_BASE_URL=
